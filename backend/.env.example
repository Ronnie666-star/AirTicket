# ===== 环境变量模板 =====
# 用法：复制本文件为 .env 并填入真实值。.env 已被 git 忽略、不会入库，本模板入库供参考。
# Docker 部署同样用这个 .env：compose 的 env_file 或 docker run --env-file 读它注入容器。
#
# JWT HS256 签名密钥：长度必须 >= 32 字节，可用 openssl rand -base64 48 生成
JWT_SECRET=replace-me-with-a-strong-random-secret-at-least-32-bytes
# token 有效期（小时）
JWT_EXPIRE_HOURS=24
